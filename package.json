{
  "name": "bufferbase",
  "version": "2.0.0",
  "description": "Buffer-to-BaseN Encoder, Decoder, Converter, and Validator",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && tsconfig-to-dual-package",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build",
    "release": "semantic-release",
    "example": "bun src/example.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.1.0",
    "@types/node": "^20.11.5",
    "semantic-release": "^25.0.2",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misebox/bufferbase.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "number",
    "encode",
    "convert",
    "decimal",
    "base",
    "base16",
    "base32",
    "crockford",
    "base36",
    "base58",
    "base64",
    "Ascii85",
    "base85"
  ],
  "author": "misebox",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/misebox/bufferbase/issues"
  },
  "homepage": "https://github.com/misebox/bufferbase#readme"
}
