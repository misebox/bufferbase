#!/bin/sh
# Releases a version.
#
#   bin/release patch | minor | major | current
#
# patch, minor and major bump the version in package.json, commit it and tag
# it. current releases the version package.json already holds, tagging it if it
# is not tagged yet.
#
# Nothing leaves the machine until npm has accepted the package: the commit and
# the tag are made locally, published, and only then pushed.
set -e

LEVEL="$1"
case "$LEVEL" in
  patch|minor|major|current) ;;
  *)
    echo "usage: bin/release patch | minor | major | current" >&2
    exit 1
    ;;
esac

BRANCH=$(git branch --show-current)
if [ "$BRANCH" != "main" ]; then
  echo "On '$BRANCH'. Releases are cut from main." >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "The working tree has uncommitted changes." >&2
  git status --short >&2
  exit 1
fi

git fetch --quiet origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "main and origin/main differ. Push or pull first." >&2
  exit 1
fi

bun test

CURRENT=$(node -p "require('./package.json').version")
if [ "$LEVEL" = current ]; then
  printf 'Release %s as it stands and publish to npm? [y/N] ' "$CURRENT"
else
  NEXT=$(node -e '
    const [major, minor, patch] = require("./package.json").version.split(".").map(Number);
    const next = { major: [major + 1, 0, 0], minor: [major, minor + 1, 0], patch: [major, minor, patch + 1] };
    console.log(next[process.argv[1]].join("."));
  ' "$LEVEL")
  printf 'Release %s -> %s and publish to npm? [y/N] ' "$CURRENT" "$NEXT"
fi
read -r REPLY
case "$REPLY" in
  y|Y) ;;
  *) echo "Cancelled."; exit 1 ;;
esac

if [ "$LEVEL" = current ]; then
  VERSION="$CURRENT"
  if git rev-parse -q --verify "refs/tags/v$VERSION" > /dev/null; then
    echo "v$VERSION is already tagged."
  else
    git tag "v$VERSION"
  fi
else
  # Writes package.json, commits it and creates the tag, all local.
  npm version "$LEVEL" > /dev/null
  VERSION=$(node -p "require('./package.json').version")
  echo "Bumped to $VERSION."
fi

# Builds dist/ through prepublishOnly, then opens a browser for two-factor
# authentication. If this fails, the commit and tag are still local.
npm publish

git push --follow-tags

echo
echo "Published $VERSION and pushed v$VERSION."
